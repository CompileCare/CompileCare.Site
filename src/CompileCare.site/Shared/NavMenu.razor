@using MudBlazor
<MudLayout>
    <MudAppBar Class="compilecare-appbar" Elevation="0">
        <a class="brand" href="/" aria-label="CompileCare home">
            <img src="images/CompileCareLogo.png" alt="CompileCare" />
            <span>CompileCare</span>
        </a>
        <MudSpacer />
        <nav class="desktop-nav" aria-label="Main navigation">
            <a href="/" class="nav-item-link">Overview</a>
            <a href="/features" class="nav-item-link">Platform</a>
            <a href="/technology" class="nav-item-link">Technology</a>
            <a href="/about" class="nav-item-link">About</a>
            <a href="/contact" class="nav-item-link nav-contact">Contact</a>
        </nav>
        <div class="mobile-menu">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" AriaLabel="Open navigation" OnClick="ToggleDrawer" />
        </div>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.Right" Elevation="4" Variant="DrawerVariant.Temporary" Class="compilecare-drawer">
        <MudDrawerHeader><a class="brand drawer-brand" href="/"><img src="images/CompileCareLogo.png" alt="CompileCare" /><span>CompileCare</span></a></MudDrawerHeader>
        <MudNavMenu Dense="true">
            <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home">Overview</MudNavLink>
            <MudNavLink Href="/features" Icon="@Icons.Material.Filled.LocalHospital">Platform capabilities</MudNavLink>
            <MudNavLink Href="/technology" Icon="@Icons.Material.Filled.Memory">Technology stack</MudNavLink>
            <MudNavLink Href="/about" Icon="@Icons.Material.Filled.Info">About CompileCare</MudNavLink>
            <MudNavLink Href="/contact" Icon="@Icons.Material.Filled.ContactMail">Contact</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
</MudLayout>
@code {
    private bool _drawerOpen;
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
