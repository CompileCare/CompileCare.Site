@page "/demo"
@using System.ComponentModel.DataAnnotations
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Medium" Class="text-center mb-8">
    <MudText Typo="Typo.h3" Color="Color.Primary" Class="fw-bold">
        🚀 Schedule Your Free Demo
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-2">
        See how <b>CompileCare</b> simplifies hospital management, improves patient care, and boosts efficiency.
    </MudText>
    <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-2">
        No obligations • Guided walkthrough • Tailored to your workflow
    </MudText>
    <MudText Typo="Typo.caption" Color="Color.Info">
        ✅ Secure | 🚀 Fast Setup | 🌐 Cloud Ready
    </MudText>
</MudContainer>

<MudContainer MaxWidth="MaxWidth.Large" Class="mb-10">
    <MudPaper Elevation="4" Class="p-6 rounded-xl shadow-lg">
        <EditForm Model="@demoModel" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudTextField Label="Full Name" @bind-Value="demoModel.Name"
                                  Variant="Variant.Outlined" Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Person" Required="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField Label="Email Address" @bind-Value="demoModel.Email"
                                  Variant="Variant.Outlined" Type="InputType.Email"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email"
                                  Required="true" HelperText="We’ll never share your email." />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField Label="Hospital / Clinic Name" @bind-Value="demoModel.ClinicName"
                                  Variant="Variant.Outlined" Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.LocalHospital" Required="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField Label="Contact Number" @bind-Value="demoModel.Phone"
                                  Variant="Variant.Outlined" Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Phone"
                                  HelperText="We’ll never share your contact number." />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField Label="Message" @bind-Value="demoModel.Message"
                                  Variant="Variant.Outlined" Lines="4"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Message" />
                </MudItem>

                <MudItem xs="12" Class="text-center mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                               ButtonType="ButtonType.Submit" StartIcon="@Icons.Material.Filled.Send"
                   >
                        Open email draft
                    </MudButton>
                    
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudPaper>
</MudContainer>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h5" Class="fw-bold mb-4">Demo Preview — Illustrative Data</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">The following is a static, fictional preview. It is not connected to a live hospital or patient system.</MudText>
    <MudGrid Spacing="3">
        <MudItem xs="12" md="4">
            <MudPaper Elevation="2" Class="p-4 text-center rounded-4">
                <MudText Typo="Typo.caption">Appointments</MudText>
                <MudText Typo="Typo.h4">24</MudText>
                <MudText Typo="Typo.body2">Sample count</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="2" Class="p-4 text-center rounded-4">
                <MudText Typo="Typo.caption">Beds available</MudText>
                <MudText Typo="Typo.h4">18</MudText>
                <MudText Typo="Typo.body2">Illustrative figure</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="2" Class="p-4 text-center rounded-4">
                <MudText Typo="Typo.caption">Lab requests</MudText>
                <MudText Typo="Typo.h4">8</MudText>
                <MudText Typo="Typo.body2">Sample count</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
    <MudTable Items="@samplePatients" Dense="true" Hover="true" Class="mt-4">
        <HeaderContent>
            <MudTh>Sample Patient ID</MudTh>
            <MudTh>Visit</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Sample Patient ID">@context.PatientId</MudTd>
            <MudTd DataLabel="Visit">@context.VisitType</MudTd>
            <MudTd DataLabel="Status">@context.Status</MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-10">
    <MudGrid Justify="Justify.Center" Spacing="3">
        <MudItem xs="12" md="4">
            <MudPaper Elevation="2" Class="p-4 text-center rounded-4">
                <MudIcon Icon="@Icons.Material.Filled.Speed" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-2 fw-semibold">Workflow Planning</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Implementation timelines depend on your hospital's workflows and requirements.</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Elevation="2" Class="p-4 text-center rounded-4">
                <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Success" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-2 fw-semibold">Enterprise Security</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Security and access-control foundations are under active development.</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Elevation="2" Class="p-4 text-center rounded-4">
                <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Color="Color.Info" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-2 fw-semibold">Support Planning</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Support arrangements are agreed during onboarding.</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-10">
    <MudExpansionPanels>
        <MudExpansionPanel Text="How long does the demo take?">
            <MudText Typo="Typo.body2">The walkthrough duration and scope are agreed when scheduling.</MudText>
        </MudExpansionPanel>
        <MudExpansionPanel Text="Is the demo free?">
            <MudText Typo="Typo.body2">The initial product walkthrough is offered without obligation.</MudText>
        </MudExpansionPanel>
        <MudExpansionPanel Text="Do I need to install anything?">
            <MudText Typo="Typo.body2">The CompileCare team will confirm the demo setup and access details.</MudText>
        </MudExpansionPanel>
    </MudExpansionPanels>
</MudContainer>

@code {
    private DemoModel demoModel = new();

    [Inject] NavigationManager Navigation { get; set; } = default!;

    private readonly List<SamplePatient> samplePatients =
    [
        new("DEMO-001", "OPD", "Checked in"),
        new("DEMO-002", "Follow-up", "Scheduled"),
        new("DEMO-003", "Laboratory", "Pending")
    ];

    private void HandleValidSubmit()
    {
        var subject = Uri.EscapeDataString("CompileCare demo request");
        var body = Uri.EscapeDataString(
            $"Name: {demoModel.Name}\nEmail: {demoModel.Email}\nHospital/Clinic: {demoModel.ClinicName}\nPhone: {demoModel.Phone}\nMessage: {demoModel.Message}");

        Navigation.NavigateTo($"mailto:support@compilecare.com?subject={subject}&body={body}");
    }

    private sealed record SamplePatient(string PatientId, string VisitType, string Status);

    public class DemoModel
    {
        [Required(ErrorMessage = "Name is required")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Enter a valid email address")]
        public string? Email { get; set; }

        [Required(ErrorMessage = "Clinic name is required")]
        public string? ClinicName { get; set; }

        public string? Phone { get; set; }

        public string? Message { get; set; }
    }
}
