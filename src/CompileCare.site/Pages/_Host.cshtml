@page "/"
@namespace CompileCare.site.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="HeapCare is an India-focused hospital software platform in active development, connecting patient access, hospital operations and clinical workflows." />
    <meta name="theme-color" content="#10243a" />
    <meta property="og:title" content="HeapCare | Connected Hospital Operations" />
    <meta property="og:description" content="Explore the HeapCare hospital platform vision, current capabilities, roadmap and technology stack." />
    <meta property="og:type" content="website" />
    <title>HeapCare | Connected Hospital Operations</title>
    <link rel="icon" href="images/heapcare-mark.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" />
</head>
<body>
    <app><component type="typeof(App)" render-mode="ServerPrerendered" /></app>
    <script src="_framework/blazor.server.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>