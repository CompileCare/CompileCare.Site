@page "/"

<section class="hero d-flex align-items-center text-center text-white" style="background: linear-gradient(135deg, #007bff 0%, #00c6ff 100%); min-height: 70vh;">
    <div class="container">
        <h1 class="display-4 fw-bold animate__animated animate__fadeInDown">
            Smarter Care, <span class="highlight text-light">Simplified Operations.</span>
        </h1>
        <p class="lead mt-3 animate__animated animate__fadeInUp">
            A hospital-management platform being built around practical, connected workflows.
        </p>
        <p class="text-light mt-2">Designed to support hospital teams as their workflows evolve.</p>

        <div class="mt-5 mb-5 animate__animated animate__zoomIn">
            <a class="btn btn-light btn-lg shadow-lg me-3" href="/demo">
                🚀 Book Your Free Demo!
            </a>
            <a class="btn btn-outline-light btn-lg shadow-sm" href="/features">
                ⭐ See Key Features
            </a>
        </div>

        <div class="software-mockup mt-5 animate__animated animate__fadeInUp">
            <img src="images/software-dashboard-mockup.png" alt="Illustrative CompileCare dashboard mockup"
                 class="img-fluid rounded-4 shadow-lg" style="max-height: 200px; border: 3px solid rgba(255,255,255,0.2);">
        </div>

        <div class="mt-4">
            <span class="badge bg-success me-2">Modular foundation</span>
            <span class="badge bg-info me-2">Tenant-aware architecture</span>
            <span class="badge bg-warning">Healthcare workflows</span>
        </div>
    </div>
</section>

<section class="features-section py-5 text-center">
    <div class="container">
        <h2 class="fw-bold mb-3">Why Choose <span class="highlight">CompileCare?</span></h2>
        <p class="text-muted mb-5">Streamline your hospital operations with our powerful, intuitive, and secure platform.</p>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card p-4 shadow-sm rounded-4 h-100">
                    <div class="icon-circle bg-primary text-white mb-3">
                        <svg width="38" height="38" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
                            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                        </svg>
                    </div>
                    <h5>Integrated Workflow Roadmap</h5>
                    <p>The planned platform brings hospital workflows together as modules are delivered.</p>
                    <a href="/features#platform" class="text-primary fw-bold">Learn More →</a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card p-4 shadow-sm rounded-4 h-100">
                    <div class="icon-circle bg-success text-white mb-3">
                        <svg width="38" height="38" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2L20 6V11C20 17 16 21 12 23C8 21 4 17 4 11V6L12 2Z" />
                            <path d="M9 12L11 14L15 10" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>
                    <h5>Security Foundation</h5>
                    <p>Tenant-aware identity, authorization, and audit foundations are being implemented.</p>
                    <a href="/features#security" class="text-success fw-bold">Learn More →</a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card p-4 shadow-sm rounded-4 h-100">
                    <div class="icon-circle bg-info text-white mb-3">
                        <svg width="38" height="38" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
                            <path d="M19 18H6a4 4 0 010-8 5.5 5.5 0 0110.7-1.5A4.5 4.5 0 0119 18zm-7-9l3 3h-2v4h-2v-4H9l3-3z" />
                        </svg>
                    </div>
                    <h5>Cloud Ready</h5>
                    <p>Deployment options are evaluated against each organization's requirements.</p>
                    <a href="/features#cloud" class="text-info fw-bold">Learn More →</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cta-section text-center text-white py-5" style="background: linear-gradient(135deg, #00c6ff 0%, #007bff 100%);">
    <div class="container">
        <h2 class="fw-bold mb-3">Ready to Transform Your Hospital Management?</h2>
        <p class="lead mb-4">Get early access to the next generation of healthcare management software.</p>
        <a href="/demo" class="btn btn-light btn-lg px-5 me-3">Get Started</a>
        <a href="/" class="btn btn-outline-light btn-lg px-5">📄 Download Brochure</a>
        <p class="mt-4 text-light">Built for hospital and clinic workflows.</p>
    </div>
</section>
